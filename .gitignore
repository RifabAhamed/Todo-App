# ----------------------------------------------------------------
# Node.js
# ----------------------------------------------------------------

# Dependencies
# SCM-managed dependencies are handled by package-lock.json or yarn.lock
node_modules/

# Logs
# Log files are specific to a single environment.
logs/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables
# These files contain secrets and machine-specific settings.
.env
.env.*
!.env.example
!.env.template

# Build & Distribution
# These are generated files, not source code.
dist/
build/
.out/

# Caches & Temporary Files
.cache/
.tmp/
*.tsbuildinfo  # TypeScript incremental build cache

# Test & Coverage
# Test reports and coverage data are generated on each run.
coverage/
.nyc_output/

# OS-specific files
# These are generated by the operating system and not relevant to the project.
.DS_Store
Thumbs.db

# IDE & Editor Config
# These are user-specific editor settings.
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.code-workspace

# Package Manager Files (Yarn 2+ / Berry)
# Cache and install-state files for Yarn Plug'n'Play
.yarn/cache
.yarn/unplugged
.yarn/build-state
.pnp.*

# Common Framework Output
# Generated directories from popular frameworks
.next/        # Next.js
.nuxt/        # Nuxt.js
.svelte-kit/  # SvelteKit